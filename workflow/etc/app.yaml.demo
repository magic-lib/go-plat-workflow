# 应用配置模板
mysql: # mysql 地域/环境/变量名
  mysql_connect:
    address: 127.0.0.1:3306
    username: root
    pwEncoded: 2b772944fc4533d636a03d5793dc2ef0 #root
    database: rule-workflow
    charset: utf8mb4
    parseTime: True
    loc: Local
custom: # 自定义配置
  sensitive: # 加密敏感配置
  normal: # 非加密普通配置
    host_port:
      host: 0.0.0.0
      port: 8686
    feishu_alert_webhook: "" # 飞书告警机器人 Webhook 地址；配置后 Node 执行失败会异步推送告警到群
    mysql_log_retention_days: 2 # 日志保留天数
    # workflow 运行日志（wf_activity_logs / wf_node_logs）保留天数：
    # 未配置默认半年（180 天）；配置小于 10 天按 10 天处理；配置 >= 10 按配置值。
    # 管理端每天自动删除超过该天数的运行日志。
    workflow_log_retention_days: 180
    # ---- rulego 引擎池版本保留策略 ----
    # 每条根链在引擎池中最多保留的版本实例数量（含在线版本）。
    # 0 = 不限制数量，仅按存活时间清理（最终只剩在线版本）。
    root_chain_pool_max_versions: 2
    # 非在线版本在引擎池中的最长存活时间（分钟）。
    # 超出数量的版本按【发布时间】先后顺序错峰清理，每间隔该时长清理一个。
    # 0 = 不限制时间，仅按数量维持（超出即立即清理）。
    root_chain_pool_ttl_minutes: 30
    # ---- Activity 离线告警 ----
    # 总开关：关闭后即使环境开启了告警也不再发送。
    activity_offline_alert_enabled: true
    # 判定离线所需的心跳中断时长（秒）。worker 每 10s 上报一次心跳，默认 60s。
    # 注意只对「已发布上线」且「所在环境开启了告警」的 activity 生效，且必须曾收到过心跳
    #（从未上报心跳的属于未部署/已废弃，不告警）。
    activity_offline_alert_threshold_seconds: 60
    # 持续离线时的重复提醒间隔（分钟）。0 = 只在首次判定时提醒一次。
    # 持续离线超过 24 小时后自动停止提醒（视为长期下线），避免永久刷屏。
    activity_offline_alert_remind_minutes: 30
    # 是否启用跨副本根链失效广播（Redis pub/sub，复用各 env 已配置的 Redis）。
    # true  = 多副本部署：发布/回滚时广播通知各副本失效缓存，全副本即时切到新版本。
    # false = 单机部署：不创建 Redis 订阅与后台协程，省去开销（单机无需通知他人）。
    root_chain_broadcast_enabled: false
